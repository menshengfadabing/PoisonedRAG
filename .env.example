# LLM API 配置（支持 DeepSeek / Volcengine Ark 等 OpenAI 兼容接口）
# Volcengine Ark 示例:
#   DEEPSEEK_API_BASE=https://ark.cn-beijing.volces.com/api/v3
#   DEEPSEEK_MODEL=deepseek-v3-2-251201
# DeepSeek 官方示例:
#   DEEPSEEK_API_BASE=https://api.deepseek.com
#   DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_API_KEY=<your-deepseek-api-key>
DEEPSEEK_MODEL=deepseek-chat

# Embedding 模型配置
# Provider 选择：dashscope（阿里云 API）或 ollama（本地）
EMBEDDING_PROVIDER=dashscope

# DashScope API 配置（阿里云 Embedding 模型）
DASH_SCOPE_API_KEY=<your-dashscope-api-key>
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

# Ollama 配置（仅当 EMBEDDING_PROVIDER=ollama 时需要）
# OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# 语料分割配置
REVIEW_CHUNK_SIZE=500
REVIEW_CHUNK_OVERLAP=50

# LangSmith 配置（可选，用于追踪调试）
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=<your-langsmith-api-key>
LANGSMITH_PROJECT=poisonedRAG
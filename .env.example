# LLM API 配置（支持 DeepSeek / Volcengine Ark 等 OpenAI 兼容接口）
# Volcengine Ark 示例:
#   DEEPSEEK_API_BASE=https://ark.cn-beijing.volces.com/api/v3
#   DEEPSEEK_MODEL=deepseek-v3-2-251201
# DeepSeek 官方示例:
#   DEEPSEEK_API_BASE=https://api.deepseek.com
#   DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_API_KEY=<your-deepseek-api-key>
DEEPSEEK_MODEL=deepseek-chat

# Embedding 模型配置（OpenAI 兼容接口，通过 base_url 切换）
# DashScope（阿里云）
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_API_KEY=<your-dashscope-api-key>

# Ollama 本地（取消注释即可切换）
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_MODEL=qwen3-embedding:0.6b
# EMBEDDING_API_KEY=ollama

# vLLM / LM Studio（自定义 base_url）
# EMBEDDING_BASE_URL=http://localhost:8000/v1
# EMBEDDING_MODEL=your-embedding-model
# EMBEDDING_API_KEY=

# 语料分割配置
REVIEW_CHUNK_SIZE=500
REVIEW_CHUNK_OVERLAP=50

# 三阶段审查开关
ENABLE_INGEST_REVIEW=true
ENABLE_RETRIEVAL_FILTER=true
ENABLE_GENERATION_VALIDATOR=true

# LangSmith 配置（可选，用于追踪调试）
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=<your-langsmith-api-key>
LANGSMITH_PROJECT=poisonedRAG